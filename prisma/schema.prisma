generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  ASHA
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RiskLevel {
  GREEN
  YELLOW
  RED
}

model User {
  id           String          @id @default(uuid())
  name         String
  email        String?         @unique
  phone        String?         @unique
  passwordHash String?
  role         Role            @default(PATIENT)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  // Relations
  patientProfile PatientProfile?
  doctorProfile  DoctorProfile?
  ashaProfile    AshaProfile?
  adminProfile   AdminProfile?
}

model PatientProfile {
  id           String          @id @default(uuid())
  userId       String          @unique
  abhaId       String?         @unique
  dob          DateTime?
  gender       String?
  bloodGroup   String?
  language     String          @default("hi") // For Bhashini AI & Regional Voice
  emergencyContact String?
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  appointments Appointment[]
  records      MedicalRecord[]
  triages      AshaTriageRecord[]

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model DoctorProfile {
  id              String         @id @default(uuid())
  userId          String         @unique
  specialty       String
  hospitalId      String?
  consultationFee Int            @default(500)
  licenseNumber   String?
  availableDays   String[]       @default(["Mon", "Tue", "Wed", "Thu", "Fri"])
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility        Facility?      @relation(fields: [hospitalId], references: [id])
  
  appointments    Appointment[]
  prescriptions   MedicalRecord[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model AshaProfile {
  id           String             @id @default(uuid())
  userId       String             @unique
  villageNode  String             @default("Sitapur Node 4")
  centerCode   String?
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  triages      AshaTriageRecord[]

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model AdminProfile {
  id         String     @id @default(uuid())
  userId     String     @unique
  facilityId String?
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility   Facility?  @relation(fields: [facilityId], references: [id])

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Facility {
  id             String          @id @default(uuid())
  name           String
  type           String          // e.g. "Primary Health Center", "District Hospital", "Super Speciality"
  address        String
  latitude       Float
  longitude      Float
  contactPhone   String?
  totalBeds      Int             @default(50)
  availableBeds  Int             @default(12)
  icuBeds        Int             @default(5)
  oxygenCylinders Int            @default(20)
  doctors        DoctorProfile[]
  admins         AdminProfile[]
  appointments   Appointment[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Appointment {
  id          String            @id @default(uuid())
  tokenNumber Int               @default(1)
  date        DateTime
  timeSlot    String            @default("10:00 AM")
  status      AppointmentStatus @default(PENDING)
  notes       String?

  patientId   String
  patient     PatientProfile    @relation(fields: [patientId], references: [id], onDelete: Cascade)

  doctorId    String
  doctor      DoctorProfile     @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  facilityId  String?
  facility    Facility?         @relation(fields: [facilityId], references: [id])

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model MedicalRecord {
  id            String         @id @default(uuid())
  patientId     String
  patient       PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  doctorId      String?
  doctor        DoctorProfile? @relation(fields: [doctorId], references: [id])

  diagnosis     String
  prescriptions Json?          // List of medicines: [{ name, dosage, frequency, days }]
  aiSummary     String?        // 3-bullet clinical summary generated by Gemini
  labReports    String[]       // URLs to PDF reports
  vitals        Json?          // { bp, spo2, pulse, temp, bloodSugar }

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model AshaTriageRecord {
  id          String         @id @default(uuid())
  ashaId      String
  asha        AshaProfile    @relation(fields: [ashaId], references: [id], onDelete: Cascade)

  patientId   String
  patient     PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  riskLevel   RiskLevel      @default(GREEN)
  riskScore   Int            @default(20) // 0-100
  symptoms    String[]
  bpSystolic  Int?
  bpDiastolic Int?
  spO2        Int?
  bloodSugar  Int?
  tempF       Float?
  notes       String?
  isSynced    Boolean        @default(true)

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}
